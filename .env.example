# Copy this file to .env and add your own key. Never commit the real key.
KBS_INFERENCE_APIKEY=

# Required by the default anchored LLM-expansion query strategy.
WEB_RAG_LLM_PROVIDER=openai
WEB_RAG_LLM_BASE_URL=https://inference.kbs.uni-hannover.de/v1
WEB_RAG_LLM_API_KEY_ENV=KBS_INFERENCE_APIKEY
WEB_RAG_LLM_MODEL=qwen3.6:35b-a3b-bf16
WEB_RAG_LLM_TEMPERATURE=0
WEB_RAG_LLM_TIMEOUT=300
WEB_RAG_HYDE_MAX_TOKENS=180
WEB_RAG_EXPANSION_MAX_TOKENS=160
WEB_RAG_EXPANSION_MAX_TERMS=6
WEB_RAG_EXPANSION_MAX_QUERY_CHARS=600

# Best document-retrieval configuration from the completed 90-question test.
WEB_RAG_RETRIEVAL_SYSTEM=fusion
WEB_RAG_QUERY_STRATEGY=llmexpand
WEB_RAG_RETRIEVAL_LIMIT=20
WEB_RAG_PAPERCLIP_SOURCE=pmc,biorxiv,medrxiv,arxiv,abstracts_only
WEB_RAG_PAPERCLIP_RANKING=vector
WEB_RAG_PAPERCLIP_CANDIDATE_LIMIT=30
WEB_RAG_PAPERCLIP_QUERY_FUSION=true
WEB_RAG_QUERY_FUSION_RRF_K=10
WEB_RAG_REFORMULATED_QUERY_WEIGHT=0.5
WEB_RAG_PAPERCLIP_FULL_CORPUS=true
WEB_RAG_PAPERCLIP_TIMEOUT=120

WEB_RAG_EUROPEPMC_MODE=multi
WEB_RAG_EUROPEPMC_SYNONYM=false
WEB_RAG_EUROPEPMC_USE_REFORMULATED_QUERY=false
WEB_RAG_EUROPEPMC_CANDIDATE_LIMIT=30
WEB_RAG_EUROPEPMC_TIMEOUT=45
WEB_RAG_EUROPEPMC_CACHE_DIR=outputs/europepmc_cache
WEB_RAG_FUSION_RRF_K=60

WEB_RAG_CHUNKING_METHOD=token_aware
WEB_RAG_CHUNK_TOKENIZER_MODEL=ncbi/MedCPT-Cross-Encoder
WEB_RAG_CHUNK_MAX_TOKENS=512
WEB_RAG_CHUNK_OVERLAP=0.20
WEB_RAG_CHUNK_MAX_OVERLAP_SENTENCES=5
WEB_RAG_MIN_CHUNK_WORDS=5

WEB_RAG_RERANKER=medcpt
WEB_RAG_TOP_K=20
WEB_RAG_MAX_CHUNKS_PER_PAPER=4
WEB_RAG_NEAR_DUPLICATE_THRESHOLD=0.95
WEB_RAG_MEDCPT_MODEL=ncbi/MedCPT-Cross-Encoder
WEB_RAG_MEDCPT_MAX_LENGTH=512
WEB_RAG_MEDCPT_BATCH_SIZE=8
WEB_RAG_MEDCPT_DEVICE=auto
