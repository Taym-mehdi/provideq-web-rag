{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paperclip project schema discovery",
  "description": "Reusable paper-level observations used to design, not replace, a project extraction schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "candidate_fields",
    "cross_field_rules",
    "missing_or_ambiguous",
    "out_of_scope_observations"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_id",
          "category",
          "value_type",
          "vocabulary_policy",
          "proposed_required",
          "definition",
          "rationale",
          "categorical_options",
          "source_examples"
        ],
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value_type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "categorical"
            ]
          },
          "vocabulary_policy": {
            "type": "string",
            "enum": [
              "bounded",
              "open",
              "hybrid"
            ],
            "description": "Bounded uses approved options; open preserves free-form normalized text; hybrid uses stable broad options plus as-reported/open detail."
          },
          "proposed_required": {
            "type": "boolean"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "categorical_options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "definition",
                "aliases",
                "source_examples"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "definition": {
                  "type": "string",
                  "minLength": 1
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "source_examples": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/source_example"
                  }
                }
              }
            }
          },
          "source_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/source_example"
            }
          }
        }
      }
    },
    "cross_field_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "affected_fields",
          "source_examples"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "affected_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/source_example"
            }
          }
        }
      }
    },
    "missing_or_ambiguous": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "affected_fields",
          "source_examples"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "affected_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/source_example"
            }
          }
        }
      }
    },
    "out_of_scope_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "reason",
          "source_examples"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/source_example"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "source_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_reported",
        "path",
        "lines"
      ],
      "properties": {
        "as_reported": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/papers/[^/]+/.+$"
        },
        "lines": {
          "type": "string",
          "pattern": "^L[1-9][0-9]*(?:-L[1-9][0-9]*)?$"
        }
      }
    }
  }
}
