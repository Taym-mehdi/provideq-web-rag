{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip.gxl.ai/schemas/report_spec.schema.json",
  "title": "Paperclip report specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audience",
    "tldr",
    "section_order",
    "labels",
    "figure_inventory",
    "visibility",
    "provenance_notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "tldr": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "section_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "labels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "figure_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "source_artifacts",
          "visible"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "visible": {
            "type": "boolean"
          }
        }
      }
    },
    "visibility": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "provenance_notes": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
